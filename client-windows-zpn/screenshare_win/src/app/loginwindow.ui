}

QTabWidget {
    background: #ffffff;
}

QTabWidget::pane {
    border: none;
    top: -1px;
    background: #ffffff;
}

QTabBar::tab {
    min-width: 138px;
    min-height: 36px;
    margin: 0 5px;
    border-radius: 18px;
    color: #667085;
    background: #f2f4f7;
    font-size: 14px;
}

QTabBar::tab:selected {
    background: #1677ff;
    color: white;
    font-weight: 700;
}

QLabel#labelLoginUsername,
QLabel#labelLoginPassword,
QLabel#labelRegisterUsername,
QLabel#labelRegisterNickname,
QLabel#labelRegisterPassword,
QLabel#labelRegisterConfirm {
    background: transparent;
    color: #344054;
    font-size: 13px;
    font-weight: 600;
}

QLineEdit {
    border: 1px solid #d0d5dd;
    border-radius: 9px;
    padding: 0 12px;
    background: white;
    color: #101828;
    font-size: 14px;
    min-height: 40px;
}

QLineEdit:focus {
    border: 1px solid #1677ff;
}

QPushButton#btnLogin,
QPushButton#btnRegister {
    background: #1677ff;
    color: white;
    border: none;
    border-radius: 9px;
    min-height: 42px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#btnLogin:hover,
QPushButton#btnRegister:hover {
    background: #4096ff;
}

QPushButton#btnLogin:pressed,
QPushButton#btnRegister:pressed {
    background: #0958d9;
}

QCheckBox {
    background: transparent;
    color: #667085;
    font-size: 13px;
}

QLabel#labelHint {
    background: transparent;
    color: #667085;
    font-size: 12px;
}</string>
