  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: white;
    font-family: &quot;Microsoft YaHei&quot;;
    color: #1f2329;
}

QLabel#labelMainScreen {
    background-color: #f2f3f5;
    border: 2px solid #dcdfe6;
    border-radius: 14px;
    color: #8a94a6;
    font-size: 24px;
    font-weight: bold;
}

QScrollArea#participantScrollArea {
    background: transparent;
    border: none;
}

QWidget#participantContainer {
    background: transparent;
}

QLabel#labelParticipantHint,
QLabel#participantTile {
    background-color: #ffffff;
    border: 1px solid #dcdfe6;
    border-radius: 12px;
    font-size: 15px;
    font-weight: bold;
    color: #334155;
    padding: 4px;
}

QLabel#labelStatus {
    font-size: 16px;
    font-weight: bold;
    color: #1f2329;
}

QPushButton {
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    min-width: 100px;
    min-height: 40px;
}

QPushButton#btnShare {
    background-color: #1677ff;
    color: white;
}

QPushButton#btnShare:hover {
    background-color: #4096ff;
}

QPushButton#btnEnd {
    background-color: #ff4d4f;
    color: white;
}

QPushButton#btnEnd:hover {
    background-color: #ff7875;
}

QPushButton#btnAnnotate {
    background-color: #22c55e;
    color: white;
}

QPushButton#btnAnnotate:hover {
    background-color: #4ade80;
}

QPushButton#btnAnnotate:disabled {
    background-color: #cbd5e1;
    color: #64748b;
}

QPushButton#btnHostMeeting,
QPushButton#btnConnectLocal,
QPushButton#btnCamera {
    background-color: #e5e7eb;
    color: #111827;
}

QPushButton#btnHostMeeting:hover,
QPushButton#btnConnectLocal:hover,
QPushButton#btnCamera:hover {
    background-color: #dbeafe;
    color: #1677ff;
}</string>
